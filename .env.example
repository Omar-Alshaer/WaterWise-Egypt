# Firebase client values are public identifiers (not passwords).
# Firebase Console -> Project settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Explicitly opt-in after security/privacy readiness, default disabled
NEXT_PUBLIC_ENABLE_AUTH=false

# Future admin batch: NEVER expose Firebase Admin SDK credentials as NEXT_PUBLIC_.
# Server-only credentials must be stored as Vercel environment secrets.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
