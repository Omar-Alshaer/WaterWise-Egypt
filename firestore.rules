rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function owner(userId){return signedIn()&&request.auth.uid==userId;}
  function profileKeys(){
   return ['displayName','email','phone','phoneVerified','consentVersion','createdAt','updatedAt'];
  }
  function validProfile(userId){
   return owner(userId)
    && request.resource.data.keys().hasAll(profileKeys())
    && request.resource.data.keys().hasOnly(profileKeys())
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size()>=2
    && request.resource.data.displayName.size()<=100
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.phone is string
    && request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$')
    && request.resource.data.phoneVerified==false
    && request.resource.data.consentVersion=='2026-10'
    && request.resource.data.createdAt==request.time
    && request.resource.data.updatedAt==request.time;
  }
  match /users/{userId} {
   allow get:if owner(userId);
   allow list:if false;
   allow create:if validProfile(userId);
   // Self-service edits can change name/phone only. Realtime profile data is read-only otherwise.
   allow update:if owner(userId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone','updatedAt'])
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size()>=2
    && request.resource.data.displayName.size()<=100
    && request.resource.data.phone is string
    && request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$')
    && request.resource.data.updatedAt==request.time;
   allow delete:if false;
   match /{document=**}{allow read,write:if false;}
  }
  match /{document=**}{allow read,write:if false;}
 }
}
